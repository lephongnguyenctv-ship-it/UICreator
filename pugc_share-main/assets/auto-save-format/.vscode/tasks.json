{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format FC Code",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/format-fc.ps1",
        "-FilePath",
        "${file}"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": true,
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
